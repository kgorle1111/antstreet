{
  "description": "AntStreet: say how to get uv when it is missing, and check the latest run's ledger when the agent stops.",
  "modules": [
    "./approve-pane.tsx"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/check-uv.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/ledger-check.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
