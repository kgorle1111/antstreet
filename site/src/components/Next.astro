---
import { ROADMAP_URL } from "../data/links";

// From ROADMAP.md, "Now" and "Next". Only unbuilt items belong here.
const now = [
  ["antstreet on PyPI", "so nothing needs a clone. Publishing is imminent, not done."],
  ["CI export", "carry a sealed run to CI so the GitHub Action needs no manual step."],
];
const next = [
  ["First run", "a short --help, a timed fresh-machine run in the README, a first-run guide."],
];
const built = "Already built: a one-command audit (antstreet audit) with a Claude Code Stop hook, and check strength, which flags checks that pass deliberately broken copies of the changed code. See the roadmap for the full shipped list.";
---
<section id="next" class="section next" aria-labelledby="next-h">
  <div class="wrap">
    <p class="eyebrow">Roadmap</p>
    <h2 id="next-h">Up next. Only unbuilt items are listed.</h2>
    <div class="cols">
      <div>
        <h3 class="col-h">Now</h3>
        <ul class="items">{now.map(([t, d]) => <li><strong>{t}</strong>: {d}</li>)}</ul>
      </div>
      <div>
        <h3 class="col-h">Next</h3>
        <ul class="items">{next.map(([t, d]) => <li><strong>{t}</strong>: {d}</li>)}</ul>
      </div>
      <aside class="report" aria-labelledby="report-h">
        <p class="soon mono">Coming</p>
        <h3 id="report-h">The Honesty Report</h3>
        <p>A repeatable, pre-registered measurement of how often AI-written checks pass while hidden checks fail. Method first, results when they exist.</p>
      </aside>
    </div>
    <p class="built">{built}</p>
    <p class="more"><a href={ROADMAP_URL}>The full roadmap</a></p>
  </div>
</section>

<style>
  .cols { display: grid; gap: 28px; margin-top: 32px; }
  @media (min-width: 960px) { .cols { grid-template-columns: 1fr 1fr 0.9fr; gap: 40px; } }
  .col-h { font-size: 24px; margin-bottom: 12px; }
  .items { margin: 0; padding-left: 20px; display: grid; gap: 12px; }
  .report { border: 2px dashed var(--ink); border-radius: 16px; padding: 22px; align-self: start; }
  .report h3 { font-size: 24px; margin: 10px 0 8px; }
  .soon { display: inline-block; font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; background: var(--yellow); color: var(--navy); padding: 4px 10px; border-radius: 999px; }
  .built { margin-top: 24px; }
  .more { margin-top: 24px; font-weight: 700; }
</style>
